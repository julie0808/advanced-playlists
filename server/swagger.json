{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "title": "FancYT CRUD",
    "description": "All operations for Videos and Tags",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "host": "localhost:4200",
  "basePath": "/api/v1/",
  "tags": [
    {
      "name": "Tags",
      "description": "Tags API"
    },
    {
      "name": "Videos",
      "description": "Videos API"
    }
  ],
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/tags": {
      "get": {
        "tags": ["Tags"],
        "summary": "Get all tags by playlist",
        "parameters": [
          {
            "name": "playlist_id",
            "in": "query",
            "description": "The playlist ID",
            "schema": {
              "type": "string"
            },
            "example": {
              "playlist_id": "PLwgftAdEcD4rXHmDdFTFI8Hch3BfWBQIt"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Tags"
            }
          }
        }
      },
      "post": {
        "tags": ["Tags"],
        "summary": "Create new tag",
        "description": "Create new tag",
        "parameters": [
          {
            "name": "tag",
            "in": "body",
            "description": "Tag that we want to create",
            "schema": {
              "$ref": "#/definitions/Tag"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "New tag was created",
            "schema": {
              "$ref": "#/definitions/Tag"
            }
          },
          "500": {
            "description": "An server error occured"
          }
        }
      },
      "put": {
        "summary": "Update tag with given ID",
        "tags": ["Tags"],
        "parameters": [
          {
            "name": "tag",
            "in": "body",
            "description": "Tag with new values",
            "schema": {
              "$ref": "#/definitions/Tag"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tag was updated",
            "schema": {
              "$ref": "#/definitions/Tag"
            }
          }
        }
      }
    },
    "/tags/{id}": {
      "delete": {
        "summary": "Delete tag with given ID",
        "tags": ["Tags"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The tag ID",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tag was deleted",
            "schema": {
              "$ref": "#/definitions/Tag"
            }
          }
        }
      }
    },
    "/playlist": {
      "get": {
        "tags": ["Playlists"],
        "summary": "Get informations associated to playlists",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }       
    }, 
    "/video/update": {
      "post": {
        "tags": ["Videos"],
        "summary": "Insert a batch of new videos (maximum 250)",
        "parameters": [
          {
            "name": "videos",
            "in": "body",
            "description": "Video records to insert",
            "schema": {
              "$ref": "#/definitions/VideoBatch"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Videos inserted or already present",
            "schema": {
              "type": "object",
              "properties": {
                "received": {
                  "type": "integer"
                },
                "inserted": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }       
    },
    "/video/tags/update/{id}": {
      "put": {
        "tags": ["Videos"],
        "summary": "Update assigned tags for a video",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The youtube ID",
            "schema": {
              "type": "string"
            },
            "example": {
              "id": "sPBVzqOax3Y"
            }
          },
          {
            "name": "tags",
            "in": "body",
            "description": "Object of tags to assign to video",
            "schema": {
              "$ref": "#/definitions/Tags"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Tags"
            }
          }
        }
      }       
    },
    "/video": {
      "get": {
        "tags": ["Videos"],
        "summary": "Get all informations associated to videos",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }       
    }     
  },
  "definitions": {
    "Tag": {
      "required": [
        "id", 
        "title",
        "color",
        "description",
        "parent_tag_id",
        "lst_children_tag",
        "playlist_id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "uniqueItems": true
        },
        "title": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "unique_code": {
          "type": "string"
        },
        "parent_unique_code": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "parent_tag_id": {
          "type": "integer"
        },
        "is_shared": {
          "type": "boolean"
        },
        "lst_children_tag": {
          "type": "array",
          "$ref": "#/definitions/Tag"
        },
        "playslist_id": {
          "type": "integer"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "Tags": {
      "type": "array",
      "$ref": "#/definitions/Tag"
    },
    "Video": {
      "required": [
        "youtubeId",
        "rating", 
        "title", 
        "length", 
        "dateModified",
        "tags",
        "artist",
        "publishedBy"],
      "properties": {
        "youtubeId": {
          "type": "string",
          "uniqueItems": true
        },
        "rating": {"type": "number"},
        "needsReview": {"type": "boolean"},
        "title": {"type": "string"},
        "length": {"type": "string"},
        "dateModified": {"type": "string"},
        "tags": {
          "type": "string"
        },
        "artist": {"type": "string"},
        "publishedBy": {"type": "string"}
      }
    },
    "VideoBatch": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/definitions/VideoForInsert"
      }
    },
    "VideoForInsert": {
      "type": "object",
      "required": [
        "youtubeId",
        "title",
        "uniqueYoutubeId"
      ],
      "properties": {
        "youtubeId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "uniqueYoutubeId": {
          "type": "string"
        }
      }
    }
  }
}

